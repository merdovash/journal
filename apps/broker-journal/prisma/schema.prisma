generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloseReason {
  manual
  take_profit
  stop_loss
}

model TradeOpen {
  id          String      @id @default(cuid())
  openedAt    DateTime
  instrument  String
  price       Decimal     @db.Decimal(18, 6)
  commission  Decimal     @db.Decimal(18, 6)
  stopLoss    Decimal?    @db.Decimal(18, 6)
  takeProfit  Decimal?    @db.Decimal(18, 6)
  leverage    Decimal     @db.Decimal(18, 6)
  quantity    Decimal     @db.Decimal(18, 6)
  openReason  String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  close       TradeClose?

  @@index([openedAt])
  @@index([instrument])
}

model TradeClose {
  id          String      @id @default(cuid())
  openId      String      @unique
  open        TradeOpen   @relation(fields: [openId], references: [id], onDelete: Restrict)
  closedAt    DateTime
  price       Decimal     @db.Decimal(18, 6)
  commission  Decimal     @db.Decimal(18, 6)
  closeReason CloseReason
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([closedAt])
}

/// Singleton settings row (id always "default")
model BrokerSettings {
  id              String   @id @default("default")
  startingBalance Decimal  @db.Decimal(18, 6)
  updatedAt       DateTime @updatedAt
}
