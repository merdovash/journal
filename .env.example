# PostgreSQL connection string (docker-compose defaults below)
DATABASE_URL="postgresql://broker:broker@localhost:5432/broker_journal?schema=public"

# --- Portal auth integration (project_hub owns login) ---
# Local demo: leave AUTH_REQUIRED unset/false so the journal works without portal.
# AUTH_REQUIRED="true"
# AUTH_DEV_BYPASS="true"
# AUTH_DEV_USER_ID="dev-user"
# AUTH_DEV_USER_EMAIL="dev@localhost"
# AUTH_DEV_USER_NAME="Dev User"

# ASSUMPTION — verify cookie / JWT names against C:\projects\portal
# AUTH_COOKIE_NAME="portal_session"
# AUTH_JWT_SECRET="replace-with-shared-portal-secret"
# AUTH_TRUST_PROXY_HEADERS="true"
# AUTH_PROXY_SECRET="replace-with-proxy-shared-secret"
# PORTAL_LOGIN_URL="http://127.0.0.1:3000/login"

# Mount under portal path (rebuild required after change)
# NEXT_PUBLIC_BASE_PATH="/broker"
# NEXT_PUBLIC_ASSET_PREFIX=""
